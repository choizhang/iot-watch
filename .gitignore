# ==========================================
# Global & Environment Ignores
# ==========================================
.DS_Store
.env
.env.local
.env.*.local
*.log
*.pid
.logs/
.trae/
.idea/
.vscode/*
!.vscode/extensions.json

# ==========================================
# Node.js & Frontend Ignores
# ==========================================
node_modules/
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Go Backend Ignores
# ==========================================
backend/.env
backend/.env.*
backend/bin/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/*.test
backend/*.out
backend/vendor/
backend/go.work
backend/go.work.sum

# ==========================================
# Playwright & E2E Testing Ignores
# ==========================================
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/
